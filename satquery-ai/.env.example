# SatQuery AI — Environment Configuration
# Copy this to .env and customize

# ─────────────────────────────────────────────
# Device Settings
# ─────────────────────────────────────────────
DEVICE=auto              # auto | cpu | cuda | mps
ENABLE_GPU=true

# ─────────────────────────────────────────────
# Paths
# ─────────────────────────────────────────────
MODEL_CACHE_DIR=./models/cache
DATA_DIR=./data

# ─────────────────────────────────────────────
# Upload Limits
# ─────────────────────────────────────────────
MAX_UPLOAD_MB=500
MAX_IMAGE_DIM=1024

# ─────────────────────────────────────────────
# Models
# ─────────────────────────────────────────────
DEFAULT_VLM_MODEL=Salesforce/blip-image-captioning-base
ENABLE_REMOTE_MODELS=false

# ─────────────────────────────────────────────
# Optional: Local LLM via Ollama
# ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─────────────────────────────────────────────
# Analysis Parameters
# ─────────────────────────────────────────────
CHANGE_THRESHOLD=0.15
MIN_REGION_AREA_PX=50
CONFIDENCE_MIN_THRESHOLD=0.3

# ─────────────────────────────────────────────
# Google Gemini AI Analyst (Optional)
# ─────────────────────────────────────────────
# Server-side API key for Gemini function calling & synthesis.
# Leave empty to use local deterministic Remote Sensing orchestration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
PRECISION_MODE=balanced

# ─────────────────────────────────────────────
# Debug
# ─────────────────────────────────────────────
DEBUG=false

